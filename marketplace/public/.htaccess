Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Production only: force HTTPS and the bare domain (one canonical URL per page = better SEO)
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
RewriteCond %{HTTPS} off
RewriteRule ^ https://cybergaminglb.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.cybergaminglb\.com$ [NC]
RewriteRule ^ https://cybergaminglb.com%{REQUEST_URI} [L,R=301]

# Never serve dotfiles (except .well-known for SSL validation)
RewriteRule ^\.(?!well-known) - [F]

# Real files/folders are served as-is; everything else goes to the PHP front controller
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
